# ==================================================
# LOCAL DEVELOPMENT (Docker + PostgreSQL)
# ==================================================
# Use these for local Docker development
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/coffee_machine"
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=coffee-machine-secret-key-development
NODE_ENV=development

# ==================================================
# PRODUCTION (Vercel + Supabase)
# ==================================================
# Uncomment and use these for Vercel + Supabase deployment

# Supabase Configuration
# Get these from: https://app.supabase.com/project/_/settings/api
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database URL for Prisma (Supabase)
# Get from: https://app.supabase.com/project/_/settings/database
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-ID].supabase.co:5432/postgres"

# Next.js Production
# NEXTAUTH_URL=https://your-app-name.vercel.app
# NEXTAUTH_SECRET=your-production-secret-key-here
# NODE_ENV=production
